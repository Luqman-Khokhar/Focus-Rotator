{
  "name": "focus-rotator",
  "productName": "Focus Rotator",
  "version": "0.1.0",
  "description": "Floating timer that rotates focus across your Chrome profiles, VS Code windows and other apps.",
  "main": "src/main.js",
  "author": {
    "name": "Luqman Khokhar"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.focusrotator.desktop",
    "productName": "Focus Rotator",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Rotate focus across your projects on a timer",
      "executableName": "focus-rotator",
      "desktop": {
        "entry": {
          "StartupWMClass": "focus-rotator"
        }
      }
    },
    "deb": {
      "maintainer": "Luqman Khokhar <Luqman-Khokhar@users.noreply.github.com>",
      "depends": [
        "wmctrl",
        "xdotool"
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
